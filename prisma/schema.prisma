generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TEACHER
  STUDENT
  PARENT
}

model User {
  id                     String   @id @default(uuid())
  email                  String   @unique
  passwordHash           String   @map("password_hash")
  name                   String
  role                   UserRole @default(TEACHER)
  lastWorkingClassId     String?  @map("last_working_class_id")
  myClassesDetailClassId String?  @map("my_classes_detail_class_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  classes  Class[]
  units    VocabularyUnit[]
  lessons  Lesson[]
  exams    Exam[]

  @@map("users")
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

model Class {
  id             String      @id
  name           String
  gradeLevel     String      @map("grade_level")
  code           String?
  classCode      String?     @map("class_code")
  teacherId      String      @map("teacher_id")
  teacherKeyHash String?     @map("teacher_key_hash")
  status         ClassStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")

  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students     Student[]
  attempts     Attempt[]
  examAttempts ExamAttempt[]
  attendance   Attendance[]
  classUnits   ClassUnit[]
  classLessons ClassLesson[]
  classExams   ClassExam[]

  @@index([teacherId])
  @@map("classes")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id          String        @id
  classId     String        @map("class_id")
  name        String
  code        String?
  dateOfBirth DateTime?     @map("date_of_birth")
  parentName  String?       @map("parent_name")
  parentPhone String?       @map("parent_phone")
  note        String?
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")

  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  attempts     Attempt[]
  examAttempts ExamAttempt[]
  attendance   Attendance[]

  @@index([classId])
  @@map("students")
}

// ─── Vocabulary ───────────────────────────────────────────────────────────────

model VocabularyUnit {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  teacher    User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  terms      VocabularyTerm[]
  classUnits ClassUnit[]

  @@index([teacherId])
  @@map("vocabulary_units")
}

model VocabularyTerm {
  id              String   @id @default(uuid())
  unitId          String   @map("unit_id")
  wordEn          String   @map("word_en")
  wordVi          String   @map("word_vi")
  imageUrl        String?  @map("image_url")
  audioUrl        String?  @map("audio_url")
  exampleSentence String?  @map("example_sentence")
  createdAt       DateTime @default(now()) @map("created_at")

  unit VocabularyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("vocabulary_terms")
}

// Junction: class ↔ vocabulary unit
model ClassUnit {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  unitId    String   @map("unit_id")
  createdAt DateTime @default(now()) @map("created_at")

  class Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  unit  VocabularyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([classId, unitId])
  @@index([classId])
  @@map("class_units")
}

// ─── Lessons (bài tập) ────────────────────────────────────────────────────────

model Lesson {
  id            String   @id @default(uuid())
  teacherId     String   @map("teacher_id")
  unitTitle     String   @map("unit_title")
  topic         String
  coverImageUrl String?  @map("cover_image_url")
  termIds       String[] @default([]) @map("term_ids")
  questions     Json
  createdAt     DateTime @default(now()) @map("created_at")

  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attempts     Attempt[]
  classLessons ClassLesson[]
  examLessons  ExamLesson[]

  @@index([teacherId])
  @@map("lessons")
}

// Junction: class ↔ lesson
model ClassLesson {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  lessonId  String   @map("lesson_id")
  createdAt DateTime @default(now()) @map("created_at")

  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([classId, lessonId])
  @@index([classId])
  @@map("class_lessons")
}

model Attempt {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  classId   String   @map("class_id")
  lessonId  String   @map("lesson_id")
  score     Int
  total     Int
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([lessonId])
  @@map("attempts")
}

// ─── Exams (đề thi) ───────────────────────────────────────────────────────────

model Exam {
  id              String   @id @default(uuid())
  teacherId       String   @map("teacher_id")
  title           String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  // questions: array of { ...exercise, points: Decimal }
  // totalPoints validated <= 10 at application layer
  questions       Json
  createdAt       DateTime @default(now()) @map("created_at")

  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  examLessons ExamLesson[]
  classExams  ClassExam[]
  attempts    ExamAttempt[]

  @@index([teacherId])
  @@map("exams")
}

// Lessons embedded/referenced in an exam
model ExamLesson {
  id       String @id @default(uuid())
  examId   String @map("exam_id")
  lessonId String @map("lesson_id")

  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([examId, lessonId])
  @@map("exam_lessons")
}

enum ExamStatus {
  ACTIVE
  CLOSED
}

// Junction: class ↔ exam (with schedule)
model ClassExam {
  id          String     @id @default(uuid())
  classId     String     @map("class_id")
  examId      String     @map("exam_id")
  scheduledAt DateTime?  @map("scheduled_at")
  dueDate     DateTime?  @map("due_date")
  maxAttempts Int        @default(1) @map("max_attempts")
  status      ExamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([classId, examId])
  @@index([classId])
  @@map("class_exams")
}

model ExamAttempt {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  classId     String   @map("class_id")
  examId      String   @map("exam_id")
  // score out of 10, stored as integer * 100 (e.g. 8.5 → 850)
  scoreX100   Int      @map("score_x100")
  totalX100   Int      @map("total_x100")
  answers     Json
  createdAt   DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([examId])
  @@map("exam_attempts")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  date      String
  studentId String   @map("student_id")
  present   Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, date, studentId], name: "attendance_class_date_student")
  @@map("attendance")
}
