### Example 2: Use Case Method (Hexagonal Architecture)

```typescript
// Use case for creating a new customer
// Orchestrates business logic: validation, password hashing, customer creation
// Uses CustomerRepositoryPort (adapter layer) for data access

export class CreateCustomerUseCase {
  constructor(private readonly customerRepository: CustomerRepositoryPort) {}

  async execute(createDto: CreateCustomerDto, createdBy?: number): Promise<CustomerEntity> {
    // Check email uniqueness within company
    const emailExists = await this.customerRepository.emailExists(createDto.email, companyId);
    if (emailExists) {
      throw new CustomerEmailExistsError(createDto.email, companyId);
    }

    // Hash password before storing
    const hashedPassword = await hashPassword(createDto.password);

    // Create customer with hashed password
    return await this.customerRepository.create({
      ...createDto,
      password: hashedPassword,
    });
  }
}
```

### Example 3: Dependency Injection with Provider

```typescript
// The AuthService class depends on JwtService, injected via the constructor

@Injectable()
export class AuthService {
  constructor(private readonly jwtService: JwtService) {}

  // Generates a JWT access token for a specific user
  async createToken(user: User): Promise<string> {
    const payload = { username: user.username, sub: user.id };
    return this.jwtService.sign(payload);
  }
}
```

### Example 4: Repository Port Implementation

```typescript
// Implements CustomerRepositoryPort interface
// Provides data access operations for Customer entities using Prisma

@Injectable()
export class PrismaCustomerRepository implements CustomerRepositoryPort {
  constructor(private readonly prisma: PrismaService) {}

  // Checks if email already exists for a given company
  async emailExists(email: string, companyId: number): Promise<boolean> {
    const count = await this.prisma.customer.count({
      where: { email, companyId },
    });
    return count > 0;
  }

  // Creates a new customer record in the database
  async create(data: CreateCustomerData): Promise<CustomerEntity> {
    return await this.prisma.customer.create({ data });
  }
}
```
