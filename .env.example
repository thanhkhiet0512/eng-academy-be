# ============================================
# DATABASE — Coolify sẽ cung cấp URL này
# ============================================
DATABASE_URL=postgresql://user:password@postgres:5432/engacademy

# ============================================
# AUTH — tạo bằng: openssl rand -base64 64
# ============================================
AUTH_SECRET=

# ============================================
# CLOUDFLARE R2 STORAGE
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ============================================
# SERVER
# ============================================
PORT=3001
NODE_ENV=production

# Allowed CORS origins (domain FE của bạn)
CORS_ORIGIN=https://your-domain.com
