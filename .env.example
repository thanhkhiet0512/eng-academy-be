# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/eng_academy?schema=public"

# JWT secret — must be at least 16 characters
AUTH_SECRET="change-me-min-16-chars"

# Server port (default: 4000)
PORT=4000

# Allowed CORS origins (comma-separated)
CORS_ORIGIN="http://localhost:4001"
